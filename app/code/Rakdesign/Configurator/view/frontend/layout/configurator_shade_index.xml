<?xml version="1.0"?>

<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Rakdesign_Configurator::css/nouislider.css" />
        <css src="Rakdesign_Configurator::css/shade.css" />
        <css src="Rakdesign_Configurator::css/configuratormodal.css" />
        <link src="Rakdesign_Configurator::js/add-to-cart.js" />
<!--        <link src="Rakdesign_Configurator::js/filters.js" />-->
    </head>
    <body>
        <attribute name="class" value="page-products"/>

        <referenceContainer name="content">
            <block class="Rakdesign\Configurator\Block\Shade" name="my_shade" cacheable="false" template="Rakdesign_Configurator::shade.phtml" />
        </referenceContainer>

        <referenceBlock name="page.main.title" remove="true" />
    </body>
</page>
