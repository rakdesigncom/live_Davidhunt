<?xml version="1.0"?>

<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Rakdesign_Configurator::css/configurator.css" />
        <css src="Rakdesign_Configurator::css/configuratormodal.css" />
        <link src="Rakdesign_Configurator::js/add-to-cart.js" />
    </head>
    <body>
        <referenceContainer name="product.info.main">
            <block class="Rakdesign\Configurator\Block\Configurator" name="product.bespokeconfigurator" template="Rakdesign_Configurator::configurator.phtml"  before="-" />
        </referenceContainer>

        <referenceContainer name="product.info.main">
            <block class="Rakdesign\Configurator\Block\Configurator" name="product.bespokeconfigurator.info" template="Rakdesign_Configurator::information.phtml"  before="-" />
        </referenceContainer>

        <referenceContainer name="product.info.details.wrapper">
            <block class="Rakdesign\Configurator\Block\Configurator" name="product.bespokeconfigurator.description" template="Rakdesign_Configurator::description.phtml"  before="-" />
        </referenceContainer>

        <move element="product.info.media" destination="content" before="product.info.main" />

        <referenceBlock name="product.info.overview" remove="true"/>
        <referenceBlock name="product.technical.information" remove="true"/>
        <referenceBlock name="product.info.description.long" remove="true"/>
        <referenceBlock name="product.info.details" remove="true"/>
        <referenceBlock name="product.info" remove="true"/>
    </body>
</page>
