            });
            function changePartSlider(element, action) {
                jQuery('.flex-shade a').removeClass('active');
                if (action == 'next') {

                    if (typeof jQuery(".additional-options-select[data-item='" + element + "'] > option:selected").next().val() !== 'undefined') {
                        jQuery(".additional-options-select[data-item='" + element + "'] > option:selected")
                                .prop("selected", false)
                                .next()
                                .prop("selected", true).change();
                    } else {
                        jQuery(".additional-options-select[data-item='" + element + "'] > option:eq(1)").prop("selected", true).change();
                    }
                }
                if (action == 'prev') {
                    if (typeof jQuery(".additional-options-select[data-item='" + element + "'] > option:selected").prev().val() !== 'undefined'
                            && jQuery(".additional-options-select[data-item='" + element + "'] > option:selected").prev().val() != '0') {
                        jQuery(".additional-options-select[data-item='" + element + "'] > option:selected")
                                .prop("selected", false)
                                .prev()
                                .prop("selected", true).change();
                    } else {
                        jQuery(".additional-options-select[data-item='" + element + "'] > option:last").prop("selected", true).change();
                    }
                }
            }

            jQuery(document).on('click', '.qty-minus-shade, .qty-minus-base', function () {
                var input = jQuery(this).parents('.flex-actions').find('input');
                var qty = parseInt(input.val()) - 1;
                if (qty > 0) {
                    input.val(qty).change();
                }
            });

            jQuery(document).on('click', '.qty-plus-shade, .qty-plus-base', function () {
                var input = jQuery(this).parents('.flex-actions').find('input');
                var qty = parseInt(input.val()) + 1;
                input.val(qty).change();
            });


            jQuery(document).on('change', '.flex-actions input', function () {
                var impact = jQuery(this).attr('data-impact');
                var value = jQuery(this).val();
                jQuery('.' + impact).attr('data-qty', value);
            });
            jQuery(document).on('click', '.configurator-controll span', function () {
                var action = jQuery(this).attr('class');
                var element = jQuery(this).parent().attr('data-item');
                changePartSlider(element, action);
            });

            jQuery(document).on('click', '.tech-image-configurator .thumb-images span', function () {
                var src = jQuery(this).find('img').attr('src');
                jQuery(this).parents('.tech-image-configurator').eq(0).find('.thumb-images span').removeClass('active');
                jQuery(this).addClass('active');
                jQuery(this).parents('.tech-image-configurator').eq(0).find('.main-image img').attr('src',src);
            });
            jQuery(document).on('swiperight', '.configurator-controll', function () {

                var element = jQuery(this).attr('data-item');
                changePartSlider(element, 'prev');
            });
            jQuery(document).on('swipeleft', '.configurator-controll', function () {

                var element = jQuery(this).attr('data-item');
                changePartSlider(element, 'next');
            });
            jQuery(document).on('click', '.load-lazy-info', function (e) {
                e.preventDefault();
                var type = jQuery(this).attr('data-type');
                var sku = jQuery('.detailed-' + type).attr('data-sku');

                var tochange = parseInt(jQuery(this).attr('data-tochange'));
                if (tochange === 0) {
                    $('html, body').animate({
                        scrollTop: jQuery('.detailed-' + type).offset().top - 100
                    }, 500);
                    return;
                }
                resetDetails(type);
                if (!sku) {
                    return;
                }
                jQuery(this).attr('data-tochange', '0');

                loadDetails(sku, type);
                loadMeasureImages(sku, type);
                if (e.originalEvent !== undefined) {
                    $('html, body').animate({
                        scrollTop: jQuery('.detailed-' + type).offset().top - 100
                    }, 500);
                }
            });




