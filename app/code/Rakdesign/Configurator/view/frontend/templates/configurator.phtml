            //.slice(key.indexOf('__')+2,-1)
            function fillInSelect(object) {
                var html = customOption;
                var dataItem = false;

                jQuery.each(object, function (key, value) {

                    if (key === 'summary') {
                        getSummary(object);
                        return;
                    }
                    if (!dataItem) {
                        dataItem = key.substr(0, key.indexOf('__'));
                    }

                    html = html + '<option value="' + key + '">' + key.slice(key.indexOf('__') + 2) + '</option>';
                });
                if (dataItem) {
                    jQuery('.additional-options-select[data-item="' + dataItem + '"]').html(html);
                }
                return;
            }




            function addSelectHtml(object, dataFill, selectedOption = false) {
                var html = customOption;
                var htmlOwlReplace = '';

                jQuery.each(object, function (key, value) {

                    var addThisOption = true;
                    if (dataFill == 'combination_line_two') { // check if shade is available within selected base
                        var oneValue = jQuery('.additional-options-select[data-item="combination_line_one"]').val();
                        if (customconfigurator[oneValue]) {
                            var availableBases = [];
                            jQuery.each(customconfigurator[oneValue], function (cKey, cValue) {
                                availableBases.push(cKey);

                            });
                            if (jQuery.inArray(key, availableBases) == -1) {
                                addThisOption = false;
                            }
                        }
                    }


                    if (dataFill == 'combination_line_one') { // check if base is available within selected shade
                        var oneValue = jQuery('.additional-options-select[data-item="combination_line_two"]').val();
                        if (customconfiguratorReverse[oneValue]) {
                            var availableBases = [];
                            jQuery.each(customconfiguratorReverse[oneValue], function (cKey, cValue) {
                                availableBases.push(cKey);

                            });
                            if (jQuery.inArray(key, availableBases) == -1) {
                                addThisOption = false;
                            }
                        }
                    }




                    if (addThisOption) { // if option is available then prrint it
                        html = html + '<option value="' + key + '">' + key.slice(key.indexOf('__') + 2) + '</option>';
                        var type = 'base';
                        if (dataFill == 'combination_line_two') {
                            type = 'shade';
                        }
                        var pImage = shadeAndBase[type][key.slice(key.indexOf('__') + 2)]['image'];
                        htmlOwlReplace = htmlOwlReplace + '<div class="item"><a href="/" class="change-base-shade" data-item="' + dataFill + '" data-name="' + key.slice(key.indexOf('__') + 2) + '"><img src="/media/catalog/product/' + pImage + '" class="img-responsive"></a></div>';
                    }

                });

                var selectedValue = jQuery('.additional-options-select[data-item="' + dataFill + '"] option:selected').val();
                jQuery('.additional-options-select[data-item="' + dataFill + '"]').html(html);

                if (jQuery('.additional-options-select[data-item="' + dataFill + '"] option[value="' + selectedValue + '"]').length > 0) {
                    jQuery('.additional-options-select[data-item="' + dataFill + '"] option[value="' + selectedValue + '"]').prop('selected', true);
                } else if (selectedOption && selectedOption[dataFill] && jQuery('.additional-options-select[data-item="' + dataFill + '"] option[value="' + selectedOption[dataFill] + '"]').length > 0) {
                    jQuery('.additional-options-select[data-item="' + dataFill + '"] option[value="' + selectedOption[dataFill] + '"]').prop('selected', true);
                } else {
                    jQuery(".additional-options-select[data-item='" + dataFill + "'] > option:selected").prop("selected", false).next().prop("selected", true);
                }
                var value = jQuery(".additional-options-select[data-item='" + dataFill + "'] > option:selected").val();
                var valueText = jQuery(".additional-options-select[data-item='" + dataFill + "'] > option:selected").text();


                var elementIndex = jQuery(".additional-options-select[data-item='" + dataFill + "'] > option:selected").index();
                elementIndex = elementIndex - 1;

                jQuery('.flex-shade.flex-shade-' + dataFill).trigger('replace.owl.carousel', htmlOwlReplace).trigger('refresh.owl.carousel').trigger("to.owl.carousel", [elementIndex, 0]);

                jQuery('.flex-shade.flex-shade-' + dataFill + ' .item a[data-name="' + valueText + '"]').addClass('active');
                return value;
            }

            function fillInConfiguratorSelect(dataFill, dataInit = false) {

                var object = customconfigurator;
                var dataFillNext = 'combination_line_two';
                if (dataFill === 'combination_line_two') {
                    object = customconfiguratorReverse;
                    dataFillNext = 'combination_line_one';
                }


                var nextIndex = addSelectHtml(object, dataFill, dataInit);
                var lastIndex = addSelectHtml(object[nextIndex], dataFillNext, dataInit);
                getSummary(object[nextIndex][lastIndex]);
                markLazyContentAsChanged(dataFill);


            }

