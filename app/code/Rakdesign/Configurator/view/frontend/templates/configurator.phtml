                    if (currentSku === sku) {
                        return;
                    }
                    params = '?sku=' + sku;
                } else {
                    var sku = jQuery('.description-content').attr('data-base');
                    var sku2 = jQuery('.description-content').attr('data-shade');
                    params = '?sku=' + sku + '&sku2=' + sku2;
                }
                jQuery('.description-content .std').html('<div class="text-center loading-technical"><i class="fa fa-spinner fa-spin"></i><br/><span>Loading, please wait...</span></div>');

                jQuery.ajax({
                    type: "GET",
                    cache: true,
                    url: '/configurator/ajax/getdescription' + params,
                })
                        .done(function (response, status, xhr) {

                            if (status === "success") {
                                if (response.status) {
                                    jQuery('.description-content').attr('data-currentsku', sku);

                                    var html = response.description;

                                    if (response.description2) {
                                        html = html + '<div class="clearfix separator-with">- with -</div>' + response.description2;
                                    }
                                    jQuery('.description-content .std').html(html);
                                } else {
                                    jQuery('.description-content .std').html('');
                                }

                            }
                            if (status === "error") {
                                jQuery('.description-content .std').html('');
                            }
                        });

            }

