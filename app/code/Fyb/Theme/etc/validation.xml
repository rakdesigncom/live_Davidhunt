<validation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Validator/etc/validation.xsd">
    <entity name="customer_address">
        <rules>
            <rule name="check_eav">
                <entity_constraints>
                    <constraint alias="eav_data_validator" class="Magento\Eav\Model\Validator\Attribute\Data" />
                </entity_constraints>
            </rule>
            <rule name="check_name">
                <entity_constraints>
                    <constraint alias="name_validator" class="Magento\Customer\Model\Validator\Name" />
                </entity_constraints>
            </rule>
            <rule name="check_street">
                <entity_constraints>
                    <constraint alias="street_validator" class="Fyb\Theme\Model\Validator\Street" />
                </entity_constraints>
            </rule>
            <rule name="check_city">
                <entity_constraints>
                    <constraint alias="city_validator" class="Fyb\Theme\Model\Validator\City" />
                </entity_constraints>
            </rule>
            <rule name="check_telephone">
                <entity_constraints>
                    <constraint alias="telephone_validator" class="Fyb\Theme\Model\Validator\Telephone" />
                </entity_constraints>
            </rule>
            <rule name="check_company">
                <entity_constraints>
                    <constraint alias="company_validator" class="Fyb\Theme\Model\Validator\Company" />
                </entity_constraints>
            </rule>
            <rule name="check_postcode">
                <entity_constraints>
                    <constraint alias="postcode_validator" class="Fyb\Theme\Model\Validator\Postcode" />
                </entity_constraints>
            </rule>
        </rules>
        <groups>
            <group name="save">
                <uses>
                    <use rule="check_eav"/>
                    <use rule="check_name"/>
                    <use rule="check_street"/>
                    <use rule="check_city"/>
                    <use rule="check_telephone"/>
                    <use rule="check_company"/>
                    <use rule="check_postcode"/>
                </uses>
            </group>
        </groups>
    </entity>
</validation>
