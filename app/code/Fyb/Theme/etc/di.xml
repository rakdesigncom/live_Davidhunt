<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Magento\Framework\View\Result\Page" type="Fyb\Theme\Framework\View\Result\Page"/>

    <type name="Magento\Quote\Model\ValidationRules\QuoteValidationComposite">
        <arguments>
            <argument name="validationRules" xsi:type="array">
                <item name="NameValidationRule" xsi:type="object">Fyb\Theme\Model\ValidationRules\NameValidationRule</item>
            </argument>
        </arguments>
    </type>

    <type name="Fyb\Theme\Model\ValidationRules\NameValidationRule">
        <arguments>
            <argument name="generalMessage" xsi:type="string" translatable="true">Please check the name fields (first name and last name).</argument>
        </arguments>
    </type>
</config>
