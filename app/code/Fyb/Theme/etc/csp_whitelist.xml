<?xml version="1.0" encoding="UTF-8"?>

<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
        <policies>
            <policy id="script-src">
                <values>
                    <value id="player.vimeo.com" type="host">player.vimeo.com</value>
                    <value id="googleapis.com" type="host">*.googleapis.com</value>
                    <value id="elfsight.com" type="host">*.elfsight.com</value>
                </values>
            </policy>

            <policy id="style-src">
                <values>
                    <value id="googleapis.com" type="host">*.googleapis.com</value>
                </values>
            </policy>

            <policy id="img-src">
                <values>
                    <value id="googleapis.com" type="host">*.googleapis.com</value>
                    <value id="gstatic.com" type="host">*.gstatic.com</value>
                    <value id="elfsightcdn.com" type="host">*.elfsightcdn.com</value>
                </values>
            </policy>

            <policy id="font-src">
                <values>
                    <value id="googleapis.com" type="host">*.googleapis.com</value>
                    <value id="gstatic.com" type="host">*.gstatic.com</value>
                </values>
            </policy>

            <policy id="connect-src">
                <values>
                    <value id="googleapis.com" type="host">*.googleapis.com</value>
                    <value id="elfsight.com" type="host">*.elfsight.com</value>
                </values>
            </policy>

            <policy id="media-src">

            </policy>

            <policy id="frame-src">

            </policy>
        </policies>
</csp_whitelist>
