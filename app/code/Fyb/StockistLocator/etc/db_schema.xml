<?xml version="1.0"?>

<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="fyb_stockist_locator" resource="default" engine="innodb" comment="Stockist Points">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="100" comment="Name"/>
        <column xsi:type="varchar" name="address_1" nullable="false" length="255" comment="Address 1"/>
        <column xsi:type="varchar" name="address_2" nullable="true" length="255" comment="Address 2"/>
        <column xsi:type="varchar" name="county" nullable="true" length="255" comment="County"/>
        <column xsi:type="varchar" name="city" nullable="false" length="255" comment="City"/>
        <column xsi:type="varchar" name="postcode" nullable="false" length="20" comment="Postcode"/>
        <column xsi:type="varchar" name="telephone" nullable="false" length="30" comment="Telephone"/>
        <column xsi:type="varchar" name="longitude" nullable="false" length="30" comment="Longitude"/>
        <column xsi:type="varchar" name="latitude" nullable="false" length="30" comment="Latitude"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
    </table>
</schema>
