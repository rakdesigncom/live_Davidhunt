<?xml version="1.0"?>

<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="header.container">
            <block class="Magento\Framework\View\Element\Template" name="cms.static.menu" template="Magento_Cms::html/cms_static_menu.phtml" after="-">
                <arguments>
                    <argument name="links_from" xsi:type="string">home_page_menu_dhl_about_us</argument>
                </arguments>
            </block>
        </referenceContainer>

        <referenceContainer name="content">
            <block class="Magento\Cms\Block\Block" name="contact.info" before="contactForm">
                <arguments>
                    <argument name="block_id" xsi:type="string">contact_us_dhl</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
