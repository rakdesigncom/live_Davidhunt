{
    "name": "magento/project-enterprise-edition",
    "description": "eCommerce Platform for Growth (Enterprise Edition)",
    "type": "project",
    "license": [
        "proprietary"
    ],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "laminas/laminas-dependency-plugin": true,
            "magento/*": true,
            "php-http/discovery": true,
            "magento/magento-composer-installer": true,
            "magento/inventory-composer-installer": true,
            "oat-sa/composer-npm-bridge": true,
            "cweagans/composer-patches": true
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "version": "2.4.6-p13",
    "require": {
        "cweagans/composer-patches": "^2.0",
        "dflydev/dot-access-data": "~3.0",
        "endroid/qr-code": "^4.8",
        "geoip2/geoip2": "~2.0",
        "magento/composer-dependency-version-audit-plugin": "~0.1",
        "magento/composer-root-update-plugin": "~2.0",
        "magento/product-enterprise-edition": "2.4.6-p15",
        "magento/quality-patches": "^1.1",
        "mageplaza/magento-2-blog-extension": "~4.2.0",
        "mageplaza/module-instagram-feed": "~4.1.0",
        "mailchimp/mc-magento2": "^103.4",
        "rootways/megamenu": "~3.0.3",
        "tecnickcom/tcpdf": "^6.7"
    },
    "autoload": {
        "exclude-from-classmap": [
            "**/dev/**",
            "**/update/**",
            "**/Test/**"
        ],
        "files": [
            "app/etc/NonComposerComponentRegistration.php"
        ],
        "psr-0": {
            "": [
                "app/code/",
                "generated/code/"
            ]
        },
        "psr-4": {
            "Magento\\": "app/code/Magento/",
            "Magento\\Framework\\": "lib/internal/Magento/Framework/",
            "Magento\\Setup\\": "setup/src/Magento/Setup/"
        }
    },
    "require-dev": {
        "allure-framework/allure-phpunit": "^2",
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7",
        "dg/bypass-finals": "^1.4",
        "friendsofphp/php-cs-fixer": "^3.8",
        "lusitanian/oauth": "^0.8",
        "magento/magento-coding-standard": "*",
        "magento/magento2-functional-testing-framework": "^4.3.1",
        "pdepend/pdepend": "^2.10",
        "phpmd/phpmd": "^2.12",
        "phpstan/phpstan": "^1.9",
        "phpunit/phpunit": "^9.5",
        "sebastian/phpcpd": "^6.0",
        "squizlabs/php_codesniffer": "^3.6",
        "symfony/finder": "^5.4",
        "symfony/process": "<=v5.4.23"
    },
    "conflict": {
        "gene/bluefoot": "*"
    },
    "autoload-dev": {
        "psr-4": {
            "Magento\\PhpStan\\": "dev/tests/static/framework/Magento/PhpStan/",
            "Magento\\Sniffs\\": "dev/tests/static/framework/Magento/Sniffs/",
            "Magento\\TestFramework\\Inspection\\": "dev/tests/static/framework/Magento/TestFramework/Inspection/",
            "Magento\\TestFramework\\Utility\\": "dev/tests/static/framework/Magento/TestFramework/Utility/",
            "Magento\\Tools\\": "dev/tools/Magento/Tools/",
            "Magento\\Tools\\Sanity\\": "dev/build/publication/sanity/Magento/Tools/Sanity/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.magento.com/"
        }
    ],
    "scripts": {
        "post-install-cmd": [
            "cp app/code/Fyb/Product/view/frontend/web/fonts/compiled/darsymbolsnew.ctg.z vendor/tecnickcom/tcpdf/fonts/darsymbolsnew.ctg.z",
            "cp app/code/Fyb/Product/view/frontend/web/fonts/compiled/darsymbolsnew.php vendor/tecnickcom/tcpdf/fonts/darsymbolsnew.php",
            "cp app/code/Fyb/Product/view/frontend/web/fonts/compiled/darsymbolsnew.z vendor/tecnickcom/tcpdf/fonts/darsymbolsnew.z",
            "bash patches/apsb26-73/apply.sh"
        ]
    },
    "extra": {
        "magento-force": "override",
        "composer-exit-on-patch-failure": true,
        "magento-deploy-ignore": {
            "*": [
                "/pub/index.php",
                "/lib/web/fotorama/fotorama.js"
            ]
        }
    }
}
